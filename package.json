{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "DeepSeek Harness desktop application: Electron shell over the web profile, with system tray, native menus, and desktop notifications",
  "version": "0.1.7-rc1",
  "author": {
    "name": "DeepSeek AI",
    "email": "support@deepseek.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luckbloke/deepseek-harness-desktop.git"
  },
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "electron .",
    "start": "node scripts/run-electron.cjs",
    "setup": "node scripts/setup-harness.cjs",
    "setup:harness": "node scripts/setup-harness.cjs",
    "sync:harness": "node scripts/sync-upstream.cjs",
    "deploy": "node scripts/align-deploy.cjs",
    "pack": "node scripts/run-electron-builder.cjs --dir --publish never",
    "dist:win": "node scripts/run-electron-builder.cjs --win --publish never",
    "dist:mac": "node scripts/run-electron-builder.cjs --mac --publish never",
    "dist:linux": "node scripts/run-electron-builder.cjs --linux --publish never",
    "dist": "node scripts/run-electron-builder.cjs --win --publish never"
  },
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^43.4.1",
    "electron-builder": "^25.0.0",
    "pnpm": "^11.22.0",
    "tar": "^7.5.22",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "ai.deepseek.dsh",
    "productName": "DeepSeek Harness",
    "directories": {
      "output": "release"
    },
    "files": [
      "lib/**/*",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "DeepSeek-Harness-${version}-portable.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
